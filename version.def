; =============================================================================
; version.def
; 本文件只管理"本 DLL 自身实现"的导出函数序号。
;
; PE Forwarder（转发到 VERSION_SRC.dll 的 15 个函数）不在此处声明，
; 原因：MSVC 链接器不支持 .def 文件里的 Forwarder 语法（= DLL.Symbol），
;       链接器会把右侧当本地符号名解析 → LNK2001。
;       Forwarder 必须通过 /EXPORT:Name=DLL.Symbol,@N 链接器选项实现，
;       在 version.cpp 中以 #pragma comment(linker, ...) 注入。
;
; 本文件职责：为 SHIM 函数指定 ordinal（不能在 .cpp 里用 /EXPORT pragma 同时
;             给 dllexport 函数指定 ordinal，否则 LNK4197 双重导出警告）。
; =============================================================================

LIBRARY version

EXPORTS
    ; ── SHIM 函数（本 DLL 实现，shim_verlanguagename.cpp 提供）──────────────
    ; 替代原来的 KERNEL32 静态转发，运行时 4 级探测。
    ; 序号 @14/@15 与真实 version.dll 导出表保持一致。
    VerLanguageNameA    @14
    VerLanguageNameW    @15
