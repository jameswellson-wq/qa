<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ===== 配置矩阵：仅 x64，Debug / Release ===== -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <!-- ===== 全局属性 ===== -->
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <Keyword>Win64Proj</Keyword>
    <ProjectGuid>{CDA4005B-FB27-4785-A4B7-6B43D4210DB5}</ProjectGuid>
    <RootNamespace>version</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <!-- ===== Debug 配置 ===== -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <!-- 修复问题3：关闭 WholeProgramOptimization，Debug 不需要 -->
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>

  <!-- ===== Release 配置 ===== -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />

  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup Label="UserMacros" />

  <!-- ===== 输出路径统一设置（两个配置共用） ===== -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <LinkIncremental>true</LinkIncremental>
    <OutDir>$(SolutionDir)build\$(Configuration)\$(Platform)\</OutDir>
    <IntDir>$(SolutionDir)build\$(Configuration)\$(Platform)\obj\</IntDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <LinkIncremental>false</LinkIncremental>
    <OutDir>$(SolutionDir)build\$(Configuration)\$(Platform)\</OutDir>
    <IntDir>$(SolutionDir)build\$(Configuration)\$(Platform)\obj\</IntDir>
  </PropertyGroup>

  <!-- ===== Debug 编译 & 链接 ===== -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_WIN64;_DEBUG;VERSION_EXPORTS;_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <!-- 修复问题3：Debug 关掉 /GS buffer check 的额外开销可选，这里保留安全检查 -->
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <!-- 额外调试信息 -->
      <DebugInformationFormat>EditAndContinue</DebugInformationFormat>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableUAC>false</EnableUAC>
      <!-- 导出表由 version.def 统一管理（@1~@17），消除 /EXPORT pragma 双写问题 -->
      <ModuleDefinitionFile>version.def</ModuleDefinitionFile>
      <!-- /NXCOMPAT 已由 MSVC 默认 /DYNAMICBASE 携带，无需重复指定 -->
    </Link>
  </ItemDefinitionGroup>

  <!-- ===== Release 编译 & 链接 ===== -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <!-- 修复问题3：O2 → MaxSpeed + 函数级链接 + 内联 -->
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <!-- 关闭 SDL：/sdl 与 /GS- 冲突会触发 D9025，proxy DLL 不需要 SDL 附加检查 -->
      <SDLCheck>false</SDLCheck>
      <PreprocessorDefinitions>_WIN64;NDEBUG;VERSION_EXPORTS;_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <!-- Release 不生成任何调试信息，去掉 /Zi 避免生成 obj 级 PDB -->
      <DebugInformationFormat>None</DebugInformationFormat>
      <!-- /GS- 通过 BufferSecurityCheck=false 注入，不再手写 AdditionalOptions -->
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <!-- 去掉运行时检查，Release 不要 RTC -->
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <!-- 修复问题1：Release 不输出 PDB（减小 artifact 体积，CI 用途） -->
      <!-- 如需 PDB 做符号调试，改为 true -->
      <GenerateDebugInformation>false</GenerateDebugInformation>
      <EnableUAC>false</EnableUAC>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <!-- 链接时代码生成（配合 WholeProgramOptimization） -->
      <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <!-- /NXCOMPAT 已由 MSVC 默认 /DYNAMICBASE 携带，无需重复指定 -->
      <!-- 导出表由 version.def 统一管理（@1~@17），消除 /EXPORT pragma 双写问题 -->
      <ModuleDefinitionFile>version.def</ModuleDefinitionFile>
    </Link>
  </ItemDefinitionGroup>

  <!-- ===== 源文件 ===== -->
  <!-- ===== 源文件 (version.cpp + SHIM 实现) ===== -->
  <ItemGroup>
    <ClCompile Include="version.cpp" />
    <ClCompile Include="shim_verlanguagename.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="resource.h" />
    <ClInclude Include="shim_verlanguagename.h" />
  </ItemGroup>
  <!-- version.def：DLL 导出表定义，链接器通过 ModuleDefinitionFile 引用 -->
  <ItemGroup>
    <None Include="version.def" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="version.rc" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />

</Project>
